{
  "children": [
    { "type": "shade", "color": "black", "opacity": 0.5 },
    {
      "type": "stack", "id": "panel", "size": [400, 0], "margin": [24, 12], "inset": [22, 18, 22, 6], "gap": 6,
      "stroke": ["ink", 0], "fill": ["panel", 0],
      "children": [
        { "type": "label", "id": "title", "size": [0, 20], "text": "$title", "font": "interfaceBold", "fontSize": 24 },
        { "type": "label", "id": "hint", "size": [0, 18], "text": "$hint", "fontSize": 14, "opacity": 0.65 },
        { "type": "group", "size": [0, 2] },
        {
          "type": "buttons", "id": "items", "items": "$choices",
          "rowHeight": 56, "minRowHeight": 30, "gap": 6, "maxColumns": 2, "columnWidth": 273, "textLines": 2,
          "when": { "short": { "gap": 10 }, "shortGuide": { "fontSize": 15, "textLines": 3 } }
        }
      ]
    }
  ]
}
